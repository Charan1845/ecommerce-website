# Copy to .env and fill in. Never commit the real .env.

PORT=3000

# Signs the login cookie. Must be a long random string in production.
JWT_SECRET=generate-a-long-random-string-for-this

# Chooses the owner password at seed time. If unset, the seed invents one
# and prints it once.
# OWNER_PASSWORD=

# The shared "look around" account on the login page.
# DEMO_LOGIN=off   turns the button off entirely
# DEMO_USERNAME=demo
# DEMO_PASSWORD=demo1234
